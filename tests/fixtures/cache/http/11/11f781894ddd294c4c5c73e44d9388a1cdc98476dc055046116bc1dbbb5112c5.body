","sha256":"133c0e1a844361de86ca2dd7c530e38b324e86177d30c52e36fd82101c190b5c"},"downloads":-1,"filename":"magika-0.6.1-py3-none-manylinux_2_28_x86_64.whl","has_sig":false,"md5_digest":"7c1e5b9a68bec5e389b3b66f91e83bfb","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.8","size":15089294,"upload_time":"2025-03-19T14:59:37","upload_time_iso_8601":"2025-03-19T14:59:37.274867Z","url":"https://files.pythonhosted.org/packages/02/b7/e7dfeb235823a82d676c68a748541c24db0249b854f945f6e3cec11c1b7e/magika-0.6.1-py3-none-manylinux_2_28_x86_64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"151aca4f908de317161044bdafc2fb8039a33efa6d2615812e4740eda88f8e5f"},"digests":{"blake2b_256":"64f0bec5bff0125d08c1bc3baef88beeb910121085249f67b5994ea961615b55","md5":"4786dc5987f828c871db0bb749dd8318","sha256":"0342b6230ea9aea7ab4b8fa92e1b46f1cc62e724d452ee8d6821a37f56738d22"},"downloads":-1,"filename":"magika-0.6.1-py3-none-win_amd64.whl","has_sig":false,"md5_digest":"4786dc5987f828c871db0bb749dd8318","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.8","size":12378455,"upload_time":"2025-03-19T14:59:40","upload_time_iso_8601":"2025-03-19T14:59:40.061117Z","url":"https://files.pythonhosted.org/packages/64/f0/bec5bff0125d08c1bc3baef88beeb910121085249f67b5994ea961615b55/magika-0.6.1-py3-none-win_amd64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"6d18ea70f6abd36f455037340f12c8125918c726d08cd6e01f0b76b6884e0c38","md5":"bfeb34c352094f286878371dc6cf3dd4","sha256":"e3dd22c73936630b1cd79d0f412d6d9a53dc99ba5e3709b1ac53f56bc998e635"},"downloads":-1,"filename":"magika-0.6.1.tar.gz","has_sig":false,"md5_digest":"bfeb34c352094f286878371dc6cf3dd4","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":3030234,"upload_time":"2025-03-19T14:59:43","upload_time_iso_8601":"2025-03-19T14:59:43.878740Z","url":"https://files.pythonhosted.org/packages/6d/18/ea70f6abd36f455037340f12c8125918c726d08cd6e01f0b76b6884e0c38/magika-0.6.1.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[]}